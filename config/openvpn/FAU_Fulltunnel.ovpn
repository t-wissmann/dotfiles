# Fulltunnel-Modus: Alle Datenpakete gehen ueber die verschluesselte
# Verbindung zum VPN-Server der FAU (z.B. fuer die Nutzung eines
# unverschluesselten WLANs oder den Zugriff auf Bibliotheksdienste).


client
#remote 131.188.12.2 1194 udp
#remote 131.188.12.2 443 udp
remote 131.188.12.2 1194 tcp
# For IPv6-only networks use: remote 2001:638:a000:1443:131:188:12:2 1194 udp6
# For IPv6-only networks use:
# remote 2001:638:a000:1443:131:188:12:2 1194 udp6

dev tun

user nobody
# NOTE: Falls hier ein Fehler auftritt durch "group nobody" ersetzen
group nobody

persist-key
persist-tun

auth-user-pass

remote-cert-tls server

verb 3

# Hide false positives in WLAN networks
mute-replay-warnings
# keepalive is pushed automatically by the server

<ca>
